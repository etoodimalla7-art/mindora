# MINDORA FastAPI Backend Environment Configuration
# Copy to .env and fill in production secrets (never commit real secrets).

APP_NAME=MINDORA
APP_ENV=production
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
APP_BASE_URL=https://mindora-w3jv.onrender.com
APP_VERSION=0.1.0
APP_TIMEZONE=Africa/Douala

# Security
JWT_SECRET_KEY=replace-with-minimum-32-character-random-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ALLOWED_ORIGINS=https://mindora.dev,https://www.mindora.dev,https://admin.mindora.dev

# PostgreSQL + pgvector + Redis
DATABASE_URL=postgresql+asyncpg://mindora:password@localhost:5432/mindora
DATABASE_URL_SYNC=postgresql+psycopg://mindora:password@localhost:5432/mindora
REDIS_URL=redis://localhost:6379/0

# Storage (Cloudflare R2 / S3 compatible)
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_PUBLIC_ENDPOINT=https://cdn.mindora.dev
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_DOCUMENTS=mindora-documents
S3_BUCKET_AVATARS=mindora-avatars
S3_BUCKET_TEMP=mindora-temp
S3_USE_SSL=true

# Gemini AI
AI_DEFAULT_PROVIDER=gemini
AI_DEFAULT_MODEL=gemini-3.1-flash-lite
AI_EMBEDDING_PROVIDER=gemini
AI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_API_KEY=

# Email (SMTP / Resend)
EMAIL_PROVIDER=smtp
EMAIL_FROM="MINDORA <noreply@mindora.dev>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Payments (Flutterwave)
PAYMENT_PROVIDER=flutterwave
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
PAYMENT_REDIRECT_SUCCESS_URL=https://mindora.dev/pricing?payment=success
PAYMENT_REDIRECT_FAILURE_URL=https://mindora.dev/pricing?payment=failed

# Notifications (FCM v1)
NOTIFICATION_PROVIDER=fcm
FCM_PROJECT_ID=mindora-app-4e384
FCM_SERVICE_ACCOUNT_PATH=

# Feature flags
FEATURE_VOICE=true
FEATURE_VISION=true
FEATURE_PAYMENTS=true
FEATURE_CONTRIBUTIONS=true
