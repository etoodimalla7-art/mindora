# =========================================================
# MINDORA — Environment Configuration (TEMPLATE)
# Copy to .env and fill in values. NEVER commit .env
# =========================================================

# ---------- App ----------
APP_NAME=MINDORA
APP_ENV=development           # development | staging | production
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_BASE_URL=http://localhost:8000
APP_VERSION=0.1.0
APP_TIMEZONE=Africa/Douala

# ---------- Security ----------
JWT_SECRET_KEY=change-me-to-a-64-char-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_HASH_ROUNDS=12
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ---------- Database ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mindora
POSTGRES_USER=mindora
POSTGRES_PASSWORD=mindora_dev_password
DATABASE_URL=postgresql+asyncpg://mindora:mindora_dev_password@localhost:5432/mindora
DATABASE_URL_SYNC=postgresql+psycopg://mindora:mindora_dev_password@localhost:5432/mindora

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# ---------- Object Storage (MinIO in dev, S3/R2 in prod) ----------
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_DOCUMENTS=mindora-documents
S3_BUCKET_AVATARS=mindora-avatars
S3_BUCKET_TEMP=mindora-temp
S3_USE_SSL=false

# ---------- Vector store (pgvector extension on Postgres) ----------
VECTOR_DIM=1536
VECTOR_INDEX_LISTS=100

# ---------- AI Providers (pluggable) ----------
AI_DEFAULT_PROVIDER=gemini
AI_DEFAULT_MODEL=gemini-1.5-flash
AI_EMBEDDING_PROVIDER=gemini
AI_EMBEDDING_MODEL=text-embedding-004
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Google Gemini (default)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# ---------- Web Search (optional, pluggable) ----------
SEARCH_PROVIDER=none          # none | tavily | brave | serpapi
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
SERPAPI_API_KEY=

# ---------- Speech / Vision (optional) ----------
STT_PROVIDER=none             # none | whisper_local | deepgram | google
DEEPGRAM_API_KEY=
TTS_PROVIDER=none             # none | google | elevenlabs
ELEVENLABS_API_KEY=

# ---------- Payments (pluggable, disabled until configured) ----------
PAYMENT_PROVIDER=none         # none | stripe | flutterwave | campay
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_KEY=
CAMPAY_APP_TOKEN=

# ---------- Email (transactional) ----------
EMAIL_PROVIDER=none           # none | smtp | resend
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@mindora.local
RESEND_API_KEY=

# ---------- Notifications ----------
FCM_SERVER_KEY=

# ---------- Rate limiting ----------
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_UPLOAD_PER_HOUR=20

# ---------- Feature flags ----------
FEATURE_WEB_RESEARCH=false
FEATURE_VOICE=false
FEATURE_VISION=false
FEATURE_PAYMENTS=false
FEATURE_CONTRIBUTIONS=true

# ---------- Observability ----------
LOG_LEVEL=INFO
SENTRY_DSN=

# ---------- Frontend (Flutter) ----------
FLUTTER_API_BASE_URL=http://localhost:8000/api/v1
