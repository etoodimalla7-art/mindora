# =========================================================
# MINDORA — Environment Configuration (TEMPLATE)
# Copy to .env and fill in values. NEVER commit .env
# =========================================================

# ---------- App ----------
APP_NAME=MINDORA
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_BASE_URL=http://localhost:8000
APP_VERSION=0.1.0
APP_TIMEZONE=Africa/Douala

# ---------- Security ----------
JWT_SECRET_KEY=change-me-to-a-64-char-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_HASH_ROUNDS=12
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,https://*.app.github.dev

# ---------- Database ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mindora
POSTGRES_USER=mindora
POSTGRES_PASSWORD=mindora_dev_password
DATABASE_URL=postgresql+asyncpg://mindora:mindora_dev_password@localhost:5432/mindora
DATABASE_URL_SYNC=postgresql+psycopg://mindora:mindora_dev_password@localhost:5432/mindora

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# ---------- Object Storage ----------
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_DOCUMENTS=mindora-documents
S3_BUCKET_AVATARS=mindora-avatars
S3_BUCKET_TEMP=mindora-temp
S3_USE_SSL=false

# ---------- Vector ----------
VECTOR_DIM=768

# ---------- AI ----------
AI_DEFAULT_PROVIDER=gemini
AI_DEFAULT_MODEL=gemini-3.1-flash-lite
AI_EMBEDDING_PROVIDER=gemini
AI_EMBEDDING_MODEL=gemini-embedding-001
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# ---------- Search ----------
SEARCH_PROVIDER=none
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
SERPAPI_API_KEY=

# ---------- Payments ----------
PAYMENT_PROVIDER=flutterwave
PAYMENT_REDIRECT_SUCCESS_URL=http://localhost:3000/#/subscription/success
PAYMENT_REDIRECT_FAILURE_URL=http://localhost:3000/#/subscription/failure

FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

CAMPAY_APP_TOKEN=

# ---------- Rate limiting ----------
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_UPLOAD_PER_HOUR=20

# ---------- Feature flags ----------
FEATURE_WEB_RESEARCH=false
FEATURE_VOICE=false
FEATURE_VISION=false
FEATURE_PAYMENTS=true
FEATURE_CONTRIBUTIONS=true

# ---------- Observability ----------
LOG_LEVEL=INFO
